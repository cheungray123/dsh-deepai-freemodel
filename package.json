{
  "name": "dsh-deepai-freemodel",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "DeepAI Code 免费模型接入 DeepSeek Harness：浏览器 OAuth 登录直连上游，自动发现本机代理，自带诊断面板与手动 Key 兜底，无需桌面客户端或网关进程。",
  "author": "cheungray123 <https://github.com/cheungray123>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheungray123/dsh-deepai-freemodel.git"
  },
  "homepage": "https://github.com/cheungray123/dsh-deepai-freemodel#readme",
  "bugs": {
    "url": "https://github.com/cheungray123/dsh-deepai-freemodel/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/ui.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepai",
    "deepai-code",
    "free-model",
    "llm-adapter",
    "llm-provider"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.4.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/cordis": "^4.0.2",
    "react": ">=18",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "streamtest": "node scripts/streamtest.mjs",
    "adaptertest": "node scripts/adaptertest.mjs",
    "plugintest": "node scripts/plugintest.mjs",
    "protocoltest": "node scripts/protocoltest.mjs",
    "proxytest": "node scripts/proxytest.mjs",
    "logintest": "node scripts/logintest.mjs"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
